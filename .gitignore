# Белый список: в репозиторий попадает только сама программа (booklet — страница, desktop — настольная версия).
# Всё остальное — старое приложение mangaforge, манга, заметки для агента — игнорируется.
/*
!/.gitignore
!/README.md
!/README.ru.md
!/LICENSE
!/booklet/
!/desktop/

/booklet/*
!/booklet/index.html
!/booklet/app.js
!/booklet/core.js
!/booklet/style.css
!/booklet/downloader.js
!/booklet/log.js
!/booklet/README.md
!/booklet/LICENSE
!/booklet/lib/
!/booklet/docs/

/desktop/*
!/desktop/package.json
!/desktop/package-lock.json
!/desktop/main.js
!/desktop/preload.js
!/desktop/logger.js
!/desktop/engine/

*.tmp.js

# Мусор системы и редакторов
Thumbs.db
desktop.ini
.DS_Store
